{
  "expo": {
    "name": "FitApp",
    "slug": "fitapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f0f"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fitappco.fitapp",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0f0f"
      },
      "package": "com.fitappco.fitapp",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "@sentry/react-native/expo",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FitApp to access your camera for barcode scanning."
        }
      ]
    ],
    "scheme": "fitapp",
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true
    }
  }
}
