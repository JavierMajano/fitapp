generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String?
  name           String
  avatarUrl      String?
  goalMode       String?
  weightKg       Float?
  heightCm       Float?
  age            Int?
  sex            String?
  activityLevel  String?
  tdeeCalories   Int?
  calorieTarget  Int?
  proteinTargetG Int?
  carbsTargetG   Int?
  fatTargetG     Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  settings        UserSettings?
  bodyLogs        BodyLog[]
  goalHistory     GoalHistory[]
  routines        Routine[]
  workoutSessions WorkoutSession[]
  cardioSessions  CardioSession[]
  foodItems       FoodItem[]
  foodLogs        FoodLog[]
  waterLogs       WaterLog[]

  @@map("users")
}

model UserSettings {
  id                   String  @id @default(uuid())
  userId               String  @unique
  unitSystem           String  @default("metric")
  theme                String  @default("dark")
  weeklyWeighInDay     Int     @default(1)
  defaultRestSeconds   Int     @default(90)
  notificationReminders Int    @default(1)
  timezone             String  @default("UTC")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model BodyLog {
  id           String   @id @default(uuid())
  userId       String
  weightKg     Float
  bodyFatPct   Float?
  muscleMassKg Float?
  notes        String?
  photoUrl     String?
  loggedDate   DateTime @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("body_logs")
}

model GoalHistory {
  id             String    @id @default(uuid())
  userId         String
  goalMode       String
  calorieTarget  Int
  proteinTargetG Int
  carbsTargetG   Int
  fatTargetG     Int
  startedAt      DateTime  @db.Date
  endedAt        DateTime? @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("goal_history")
}

model Routine {
  id          String   @id @default(uuid())
  userId      String?
  name        String
  description String?
  daysPerWeek Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  days            RoutineDay[]
  workoutSessions WorkoutSession[] @relation("RoutineSession")

  @@map("routines")
}

model RoutineDay {
  id        String @id @default(uuid())
  routineId String
  dayIndex  Int
  label     String

  routine          Routine          @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercises        RoutineExercise[]
  workoutSessions  WorkoutSession[] @relation("RoutineDaySession")

  @@map("routine_days")
}

model RoutineExercise {
  id           String  @id @default(uuid())
  routineDayId String
  exerciseId   String
  orderIndex   Int
  sets         Int
  reps         Int
  weightKg     Float?
  restSeconds  Int     @default(90)
  notes        String?

  routineDay RoutineDay @relation(fields: [routineDayId], references: [id], onDelete: Cascade)
  exercise   Exercise   @relation(fields: [exerciseId], references: [id])

  @@map("routine_exercises")
}

model Exercise {
  id           String  @id @default(uuid())
  name         String
  category     String
  equipment    String?
  movementType String?
  difficulty   String?
  instructions String?
  videoUrl     String?
  source       String  @default("custom")
  sourceRefId  String?

  muscles         ExerciseMuscle[]
  routineExercises RoutineExercise[]
  sessionSets     SessionSet[]

  @@unique([source, sourceRefId])
  @@map("exercises")
}

model ExerciseMuscle {
  id         String @id @default(uuid())
  exerciseId String
  muscleId   String
  role       String

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscle   Muscle   @relation(fields: [muscleId], references: [id])

  @@unique([exerciseId, muscleId])
  @@map("exercise_muscles")
}

model Muscle {
  id         String @id @default(uuid())
  name       String @unique
  group      String
  bodyRegion String

  exercises ExerciseMuscle[]

  @@map("muscles")
}

model WorkoutSession {
  id             String    @id @default(uuid())
  userId         String
  routineId      String?
  routineDayId   String?
  name           String
  notes          String?
  perceivedEffort Int?
  caloriesBurned Int?
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine    Routine?    @relation("RoutineSession", fields: [routineId], references: [id], onDelete: SetNull)
  routineDay RoutineDay? @relation("RoutineDaySession", fields: [routineDayId], references: [id], onDelete: SetNull)
  sets       SessionSet[]

  @@map("workout_sessions")
}

model SessionSet {
  id              String    @id @default(uuid())
  sessionId       String
  exerciseId      String
  setNumber       Int
  setType         String    @default("working")
  weightKg        Float?
  reps            Int?
  durationSeconds Int?
  distanceKm      Float?
  completed       Boolean   @default(false)
  loggedAt        DateTime  @default(now())
  editedAt        DateTime?

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id])

  @@map("session_sets")
}

model CardioSession {
  id              String   @id @default(uuid())
  userId          String
  activityType    String
  durationMinutes Int?
  distanceKm      Float?
  caloriesBurned  Int?
  avgHeartRate    Int?
  notes           String?
  loggedAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cardio_sessions")
}

model FoodItem {
  id              String  @id @default(uuid())
  userId          String?
  name            String
  brand           String?
  barcode         String?
  source          String  @default("custom")
  sourceRefId     String?
  caloriesPer100g Int
  proteinPer100g  Float
  carbsPer100g    Float
  fatPer100g      Float
  fiberPer100g    Float?
  sugarPer100g    Float?
  sodiumPer100g   Float?
  isVerified      Boolean @default(false)

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  servings     FoodServing[]
  logEntries   FoodLogEntry[]

  @@unique([source, sourceRefId])
  @@map("food_items")
}

model FoodServing {
  id         String @id @default(uuid())
  foodItemId String
  label      String
  grams      Float

  foodItem   FoodItem      @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  logEntries FoodLogEntry[]

  @@map("food_servings")
}

model FoodLog {
  id            String   @id @default(uuid())
  userId        String
  logDate       DateTime @db.Date
  totalCalories Int      @default(0)
  totalProteinG Float    @default(0)
  totalCarbsG   Float    @default(0)
  totalFatG     Float    @default(0)
  totalFiberG   Float    @default(0)

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries FoodLogEntry[]

  @@unique([userId, logDate])
  @@map("food_logs")
}

model FoodLogEntry {
  id            String    @id @default(uuid())
  foodLogId     String
  foodItemId    String
  foodServingId String?
  mealType      String
  quantityGrams Float
  calories      Int
  proteinG      Float
  carbsG        Float
  fatG          Float
  fiberG        Float     @default(0)
  loggedAt      DateTime  @default(now())
  editedAt      DateTime?

  foodLog     FoodLog      @relation(fields: [foodLogId], references: [id], onDelete: Cascade)
  foodItem    FoodItem     @relation(fields: [foodItemId], references: [id])
  foodServing FoodServing? @relation(fields: [foodServingId], references: [id], onDelete: SetNull)

  @@map("food_log_entries")
}

model WaterLog {
  id        String   @id @default(uuid())
  userId    String
  amountMl  Float
  logDate   DateTime @db.Date
  loggedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("water_logs")
}
