# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: postgresql://user:password@localhost:5432/fitapp
# Railway:   copy the public proxy URL from Railway → service → Connect
DATABASE_URL={{database.url}}

# Railway internal URL (faster — set this in Railway env vars, not locally)
DATABASE_URL_INTERNAL={{database.url.internal}}

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET={{jwt.secret}}          # used by Auth.js as signing secret

# ── OAuth ─────────────────────────────────────────────────────────────────────
# Google Cloud Console → Credentials → your OAuth 2.0 client
GOOGLE_CLIENT_ID={{expo.google.web.client}}
GOOGLE_CLIENT_SECRET={{google.client.secret}}

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local dev: redis://localhost:6379
# Railway:   copy the public proxy URL from Railway → service → Connect
REDIS_URL={{redis.url}}

# Railway internal URL (faster — set this in Railway env vars, not locally)
REDIS_URL_INTERNAL={{redis.url.internal}}

# ── External APIs ─────────────────────────────────────────────────────────────
# USDA FoodData Central — https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY={{usda.api.key}}

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:8081
