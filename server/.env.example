# Database

# Local dev — use this one
DATABASE_URL= {{database.url}}
# Production (Railway internal — faster, set this in Railway env vars)
DATABASE_URL_INTERNAL= {{database.url.internal}}
# Auth
JWT_SECRET={{jwt.secret}}          # used by Auth.js as signing secret

# Redis

# Local dev — use this one
REDIS_URL={{redis.url}}

# Production (Railway internal — faster, set this in Railway env vars)
REDIS_URL_INTERNAL= {{redis.url.internal}}
# External APIs
USDA_API_KEY=  {{usda.api.key}}

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:8081