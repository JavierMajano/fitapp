{
  "name": "fitapp",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "npx expo start --web",
    "dev:server": "cd server && npm run dev",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\"",
    "build:web": "expo export -p web",
    "eas:build:dev": "eas build --profile development --platform all",
    "eas:build:preview": "eas build --profile preview --platform all",
    "eas:build:prod": "eas build --profile production --platform all",
    "test:e2e": "node e2e/run-all.js",
    "test:e2e:regression": "node -e \"require('fs').mkdirSync('playwright-report/screenshots',{recursive:true})\" && node e2e/fitapp-regression.js",
    "test:e2e:all": "node -e \"require('fs').mkdirSync('playwright-report/screenshots',{recursive:true})\" && node e2e/fitapp-kg.js && node e2e/fitapp-lbs.js && node e2e/fitapp-regression.js && node e2e/report.js"
  },
  "dependencies": {
    "@sentry/react-native": "~7.2.0",
    "@tanstack/react-query": "^5.40.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "expo": "~54.0.0",
    "expo-auth-session": "~7.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "nativewind": "^4.0.36",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.1.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "lightningcss-wasm": "^1.27.0",
    "lint-staged": "^15.2.5",
    "playwright": "^1.57.0",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.6.1",
    "tailwindcss": "^3.4.3",
    "typescript": "~5.7.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript",
        "eslint-config-expo"
      ]
    }
  },
  "lint-staged": {
    "{app,components,lib,store,config,types,hooks}/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
