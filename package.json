{
  "name": "fitapp",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "npx expo start --web",
    "dev:server": "cd server && npm run dev",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\"",
    "build:web": "expo export -p web",
    "eas:build:dev": "eas build --profile development --platform all",
    "eas:build:preview": "eas build --profile preview --platform all",
    "eas:build:prod": "eas build --profile production --platform all",
    "test:e2e": "node e2e/run-all.js",
    "test:e2e:regression": "node -e \"require('fs').mkdirSync('playwright-report/screenshots',{recursive:true})\" && node e2e/fitapp-regression.js",
    "test:e2e:all": "node -e \"require('fs').mkdirSync('playwright-report/screenshots',{recursive:true})\" && node e2e/fitapp-kg.js && node e2e/fitapp-lbs.js && node e2e/fitapp-regression.js && node e2e/report.js"
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "eslint-plugin-react-hooks": "^5.2.0"
  },
  "dependencies": {
    "@gluestack-style/react": "^1.0.57",
    "@gluestack-ui/themed": "^1.1.51",
    "@react-native-community/datetimepicker": "8.0.1",
    "@sentry/react-native": "~5.24.3",
    "@tanstack/react-query": "^5.40.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "expo": "~51.0.0",
    "expo-auth-session": "~5.5.2",
    "expo-camera": "~15.0.0",
    "expo-constants": "~16.0.2",
    "expo-dev-client": "~4.0.29",
    "expo-image": "~1.13.0",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.0",
    "expo-secure-store": "~13.0.0",
    "expo-status-bar": "~1.12.1",
    "expo-web-browser": "~13.0.3",
    "nativewind": "^4.0.36",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.10",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.2.79",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~8.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "lightningcss-wasm": "^1.27.0",
    "lint-staged": "^15.2.5",
    "playwright": "^1.57.0",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.6.1",
    "tailwindcss": "^3.4.3",
    "typescript": "~5.7.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript",
        "eslint-config-expo"
      ]
    }
  },
  "lint-staged": {
    "{app,components,lib,store,config,types,hooks}/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
