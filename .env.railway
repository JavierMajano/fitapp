# ── Expo public vars (bundled into client — safe to expose) ───────────────────
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_APP_ENV=development   # local dev — set to 'staging' on Railway staging, 'production' on Railway prod

# Google OAuth — web client ID (Google Cloud Console → Credentials)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID={{expo.google.web.client}}
# Google OAuth — iOS client ID (Google Cloud Console → Credentials)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID={{expo.google.ios.client}}

# ── Sentry ────────────────────────────────────────────────────────────────────
# Sentry project (fitapp-expo) → Settings → Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=   # set in Railway dashboard (Sentry project fitapp-expo → Settings → Client Keys)

# ── Server-only vars — DO NOT prefix with EXPO_PUBLIC_ ───────────────────────
# These are only needed locally if you run the server from the repo root.
# In most cases, put server vars in server/.env instead.

# Auth
NEXTAUTH_URL=http://localhost:3000

# OAuth (same web client ID as above; secret from Google Cloud Console)
GOOGLE_CLIENT_ID= {{expo.google.web.client}}
GOOGLE_CLIENT_SECRET={{google.client.secret}}
