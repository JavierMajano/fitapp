# ── Expo public vars (exposed to client, prefix with EXPO_PUBLIC_) ──
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID={{expo.google.web.client}}    # Google OAuth web client ID (from Google Cloud Console)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID={{expo.google.ios.client}}    # Google OAuth iOS client ID (from Google Cloud Console)

# ── Server-only vars (never prefix with EXPO_PUBLIC_) ──

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/fitapp

# Auth
JWT_SECRET=your-secret-here          # used by Auth.js as signing secret
NEXTAUTH_URL=http://localhost:3000

# OAuth
GOOGLE_CLIENT_ID= {{expo.google.web.client}}
GOOGLE_CLIENT_SECRET= {{google.client.secret}}

# Redis
REDIS_URL=redis://localhost:6379

# External APIs
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org/api/v0
USDA_API_KEY=your-usda-key-here
USDA_BASE_URL=https://api.nal.usda.gov/fdc/v1

# Sentry
SENTRY_DSN=

# Expo
EXPO_PUBLIC_APP_ENV=development
